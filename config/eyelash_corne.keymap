#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };
		
        td1: td1 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Change Layer/Lock Layer Tap Dance";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&tog 1>;
        };

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        spc_eq: spc_eq {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            bindings = <&kp>, <&kp>;
        };

        comma_dot: comma_dot {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Comma/Dot Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp DOT>;
        };
    };

    macros {
        ord_a: ord_a {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N1 &kp KP_N7 &kp KP_N0>
                , <&macro_release &kp LALT>
                ;
        };

        ord_o: ord_o {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N1 &kp KP_N8 &kp KP_N6>
                , <&macro_release &kp LALT>
                ;
        };

        uni_euro: uni_euro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N1 &kp KP_N2 &kp KP_N8>
                , <&macro_release &kp LALT>
                ;
        };

        uni_pound: uni_pound {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N1 &kp KP_N6 &kp KP_N3>
                , <&macro_release &kp LALT>
                ;
        };

        uni_alpha: uni_alpha {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_PLUS &kp KP_N0 &kp KP_N3 &kp B &kp KP_N1>
                , <&macro_release &kp LALT>
                ;
        };

        uni_beta: uni_beta {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_PLUS &kp KP_N0 &kp KP_N3 &kp B &kp KP_N2>
                , <&macro_release &kp LALT>
                ;
        };

        uni_gamma: uni_gamma {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_PLUS &kp KP_N0 &kp KP_N3 &kp B &kp KP_N3>
                , <&macro_release &kp LALT>
                ;
        };

        uni_delta: uni_delta {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_PLUS &kp KP_N0 &kp KP_N3 &kp KP_N9 &kp KP_N4>
                , <&macro_release &kp LALT>
                ;
        };

        sup_1: sup_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N1 &kp KP_N8 &kp KP_N5>
                , <&macro_release &kp LALT>
                ;
        };

        sup_2: sup_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N1 &kp KP_N7 &kp KP_N8>
                , <&macro_release &kp LALT>
                ;
        };

        sup_3: sup_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N1 &kp KP_N7 &kp KP_N9>
                , <&macro_release &kp LALT>
                ;
        };

        sup_4: sup_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_PLUS &kp KP_N2 &kp KP_N0 &kp KP_N7 &kp KP_N4>
                , <&macro_release &kp LALT>
                ;
        };

        sup_5: sup_5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_PLUS &kp KP_N2 &kp KP_N0 &kp KP_N7 &kp KP_N5>
                , <&macro_release &kp LALT>
                ;
        };

        sup_6: sup_6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_PLUS &kp KP_N2 &kp KP_N0 &kp KP_N7 &kp KP_N6>
                , <&macro_release &kp LALT>
                ;
        };

        sup_7: sup_7 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_PLUS &kp KP_N2 &kp KP_N0 &kp KP_N7 &kp KP_N7>
                , <&macro_release &kp LALT>
                ;
        };

        sup_8: sup_8 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_PLUS &kp KP_N2 &kp KP_N0 &kp KP_N7 &kp KP_N8>
                , <&macro_release &kp LALT>
                ;
        };

        sup_9: sup_9 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_PLUS &kp KP_N2 &kp KP_N0 &kp KP_N7 &kp KP_N9>
                , <&macro_release &kp LALT>
                ;
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };

    behaviors {
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };
    };

    combos {
        compatible = "zmk,combos";
        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp GRAVE  &kp Q       &kp W       &kp E        &kp R         &kp T                                  &kp UP                &kp Y        &kp U         &kp I        &kp O       &kp P          &mo 5
&kp TAB    &hm LGUI A  &hm LALT S  &hm LCTRL D  &hm LSHIFT F  &kp G                        &kp LEFT  &kp ENTER  &kp RIGHT  &kp H        &hm RSHIFT J  &hm RCTRL K  &hm RALT L  &hm RGUI SEMI  &kp SQT
&mo 3      &kp Z       &kp X       &kp C        &kp V         &kp B          &kp SPACE               &kp DOWN              &kp N        &kp M         &kp COMMA    &kp DOT     &kp FSLH       &kp ESC
                                   &kp DEL      &mo 2         &kp SPACE                                                    &kp ENTER    &kp BSPC      &td1
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        number_layer {
            display-name = "NUMBER";
            bindings = <
&kp ESC    &kp N7      &kp N8      &kp N9       &kp FSLH      &kp ASTRK                              &mmv MOVE_UP                     &kp LBKT        &kp RBKT         &kp C_PREV       &kp C_PP        &kp C_NEXT    &kp C_MUTE
&kp CARET  &kp N4      &kp N5      &kp N6       &kp MINUS     &kp PLUS               &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp LBRC        &hm LSHIFT RBRC  &hm LCTRL PRINTSCREEN  &hm LALT INSERT &hm LGUI HOME &kp PG_UP
&kp PRCNT  &kp N1      &kp N2      &kp N3       &kp LPAR      &kp RPAR       &trans                  &mmv MOVE_DOWN                   &kp LT          &kp GT           &mo 4            &kp DEL         &kp END       &kp PG_DN
                                   &kp N0       &comma_dot                 &spc_eq SPACE EQUAL                                                     &trans          &trans           &tog 1
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        symbol_layer {
            display-name = "SYMBOL";
            bindings = <
&kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp CARET                              &mmv MOVE_UP                     &kp AMPS    &kp ASTRK  &kp LPAR   &kp RPAR   &kp MINUS  &kp EQUAL
&sup_1    &sup_2  &sup_3    &sup_4    &uni_euro  &ord_a                 &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &uni_alpha  &uni_beta  &kp SEMI   &kp LBKT   &kp RBKT   &kp BSLH
&sup_5    &sup_6  &sup_7    &sup_8    &uni_pound &ord_o        &trans                   &mmv MOVE_DOWN                   &uni_delta  &uni_gamma &kp COMMA  &kp DOT    &kp FSLH   &kp SQT
                            &sup_9    &trans     &kp SPACE                                                               &kp ENTER   &kp BSPC   &kp RSHIFT
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        function_layer {
            display-name = "Fn";
            bindings = <
&kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6                                 &mmv MOVE_UP                     &kp F7     &kp F8   &kp F9     &kp F10  &kp F11  &kp F12
&kp F13   &kp F14   &kp F15   &kp F16   &kp F17   &kp F18                &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp F19    &kp F19  &kp F20    &kp F21  &kp F23  &kp F24
&trans    &none     &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT     &trans                   &mmv MOVE_DOWN                   &kp HOME   &kp END  &kp PG_UP  &kp PG_DN &none    &none
                              &kp LC(LS(LA(LG(O))))  &kp LC(LS(LA(LG(T))))  &kp LC(LS(LA(LG(Y))))                               &kp LCTRL  &kp LALT   &kp TAB
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        controles_layer {
            display-name = "Controls";
            bindings = <
&studio_unlock  &none  &none  &none        &none        &bt BT_CLR_ALL                           &mmv MOVE_UP                     &bt BT_CLR    &none      &kp C_PREV  &kp C_PP     &kp C_NEXT   &kp C_MUTE
&sys_reset      &none  &none  &none        &none        &out OUT_TOG             &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &bt BT_SEL 0  &none      &none       &kp C_VOL_UP &kp C_BRI_UP &rgb_ug RGB_ON
&bootloader     &none  &none  &none        &none        &none          &trans                    &mmv MOVE_DOWN                   &bt BT_SEL 1  &none      &trans      &kp C_VOL_DN &kp C_BRI_DN &rgb_ug RGB_OFF
                              &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &rgb_ug RGB_TOG                                                   &bt BT_SEL 2  &bootloader &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        navigation_layer {
            display-name = "Navigation";
            bindings = <
&none  &none  &kp UP    &none      &kp HOME  &kp PG_UP                              &mmv MOVE_UP                     &none     &none     &none      &none       &none  &trans
&none  &kp LEFT &kp DOWN  &kp RIGHT  &kp END   &kp PG_DN              &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &none  &kp LSHIFT  &kp LCTRL  &kp LALT  &kp LGUI   &none
&none  &none  &none     &none      &none     &none          &trans                   &mmv MOVE_DOWN                   &none     &none     &none      &none       &none   &none
                        &none      &none     &none                                                                   &none     &none     &none
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
    };
};
